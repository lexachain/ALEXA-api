{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "alexachain",
  "main": "worker.js",
  "compatibility_date": "2026-07-15",

  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  "vars": {
  "APP_NAME": "ALEXA API",
  "APP_VERSION": "1.0.0",
  "APP_URL": "https://alexa-chain.web.app",
  "R2_PUBLIC_URL": "https://pub-a8f60358800c42019c70674605bf3995.r2.dev"
},

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "storage"
    }
  ]
}
